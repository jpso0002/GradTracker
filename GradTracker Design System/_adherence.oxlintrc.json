      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:auto|inverse)$/]",
        "message": "<Wordmark> tone must be one of 'auto' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:lockup|wordmark|mark)$/]",
        "message": "<Wordmark> variant must be one of 'lockup' | 'wordmark' | 'mark'."
      }
    ]
