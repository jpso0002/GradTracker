# GradTracker — environment configuration
#
# Copy to .env. It works AS-IS with no edits: both adapters default to `fake`,
# so a fresh clone runs and tests with no database server, no Google account and
# no API key. That property is a requirement, not a convenience (rules.md).
#
#   cp .env.example .env

# ── Required ────────────────────────────────────────────────────────────────

# Postgres URL in production; a SQLite file locally.
DATABASE_URL=file:./dev.db

# Session signing secret. Generate: openssl rand -base64 32
SESSION_SECRET=dev-only-change-me-before-any-real-deployment

# AES-256-GCM key for refresh-token encryption at rest — 32 bytes, base64.
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=dev-only-change-me-before-any-real-deployment

# `production` enables HTTPS enforcement, HSTS and the secure cookie flag.
NODE_ENV=development

# ── Adapters (default `fake` — see rules.md → Architecture) ──────────────────

# `fake` reads fixtures/emails/. `live` requires the Google credentials below.
GMAIL_ADAPTER=fake

# `fake` replays recorded fixture responses. `live` requires ANTHROPIC_API_KEY.
CLASSIFIER_ADAPTER=fake

# ── Live mode only — leave blank until T7.1 / T7.3 ──────────────────────────

# Google Cloud OAuth client (task T0.1). Scope: gmail.readonly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic API key (task T0.3).
ANTHROPIC_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────

PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Set to 1 to have the classifier return its `reasoning` field for local
# debugging. NEVER enable in production or in any environment that ships logs
# off the machine — the field quotes the email (defect C1, SM-6).
CLASSIFIER_DEBUG=0
