{
  "name": "gradtracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-powered graduate recruitment tracking dashboard",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/shared",
