{
  "name": "gradtracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-powered graduate recruitment tracking dashboard",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "typecheck:clean": "tsc --build --clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "npm run db:generate:pg --workspace @gradtracker/server && npm run db:generate:sqlite --workspace @gradtracker/server",
    "db:migrate": "node --env-file-if-exists=.env packages/server/dist/db/migrate.js"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^3.2.4"
  }
}
