{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* The client is bundled by Vite, not built by tsc. `NodeNext` would demand
     * explicit `.js` extensions on every relative import, which the vendored
     * design-system `.jsx` files cannot satisfy — they have `.d.ts` siblings,
     * not `.js` ones. `Bundler` matches how the code is actually loaded. */
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    /* Not a composite project: nothing references the client, and `noEmit`
     * is incompatible with `composite`. Typechecked directly — see the root
     * `typecheck` script. */
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,

    "allowJs": true,
    "types": ["vite/client"],
    "paths": {
      "@gradtracker/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.mjs"],
  /* Test files are excluded, as they are in the server (rules.md). They run in
   * Node under Vitest and use `node:fs`; typing them here would mean adding
   * Node's types to browser code. Until Vitest 4 they compiled only because
   * Vitest 3's types pulled Node's in transitively. */
  "exclude": ["dist", "src/ds/vendor/**/*.jsx", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
